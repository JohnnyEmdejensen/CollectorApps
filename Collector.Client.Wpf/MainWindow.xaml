<Window x:Class="Collector.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Collector.Client.Wpf"
        mc:Ignorable="d"
        Title="{DynamicResource window.main.title}" Tag="Desktop" MinHeight="800" MinWidth="1200" Background="{DynamicResource PrimaryBackground}" Icon="/Images/books_48.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Top" Height="2">
            <Label Style="{StaticResource DarkLine}"></Label>
            <Label Style="{StaticResource LightLine}"></Label>
        </StackPanel>
        <Ribbon x:Name="ribMain" Grid.Row="0" Margin="0,2,0,0" Background="{DynamicResource PrimaryBackground}">
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu>
                    <RibbonApplicationMenuItem Header="Add" ImageSource="/Images/add_32.png"></RibbonApplicationMenuItem>
                </RibbonApplicationMenu>
            </Ribbon.ApplicationMenu>
            <RibbonTab Header="{DynamicResource ribbon.tab.home.header}">
                <RibbonGroup Header="{DynamicResource ribbon.group.view.header}">
                    <RibbonToggleButton x:Name="tglStampview" IsChecked="True" Click="tglStampview_Click" Label="{DynamicResource ribbon.togglebutton.stampview.header}" LargeImageSource="Images/index_view_32.png" SmallImageSource="Images/index_view_16.png"></RibbonToggleButton>
                    <RibbonToggleButton x:Name="tglStockview" IsChecked="False" Click="tglStockview_Click" Label="{DynamicResource ribbon.togglebutton.stockview.header}" LargeImageSource="Images/box_view_32.png" SmallImageSource="Images/box_view_16.png"></RibbonToggleButton>
                </RibbonGroup>
                <RibbonGroup Header="{DynamicResource ribbon.group.panels.header}">
                    <RibbonToggleButton x:Name="tglStampDetailPanel" Click="tglStampDetailPanel_Click" Label="{DynamicResource ribbon.togglebutton.panelstampdetail.header}" LargeImageSource="/Images/window_split_hor_32.png" SmallImageSource="/Images/window_split_hor_16.png" IsChecked="False"></RibbonToggleButton>
                </RibbonGroup>
                <RibbonGroup Header="{DynamicResource ribbon.group.creation.header}">
                    <RibbonButton x:Name="btnCreateStamp" Click="btnCreateStamp_Click" LargeImageSource="/Images/photo_portrait_32.png" SmallImageSource="/Images/photo_portrait_16.png" Label="{DynamicResource ribbon.button.creation.stamp.header}"></RibbonButton>
                </RibbonGroup>
            </RibbonTab>
            <RibbonTab Header="{DynamicResource ribbon.tab.settings.header}">
                <RibbonGroup Header="{DynamicResource ribbon.group.data.header}">
                    <RibbonButton x:Name="btnCountries" Click="btnCountries_Click" Label="{DynamicResource ribbon.button.data.countries.header}" LargeImageSource="Images/earth_32.png" SmallImageSource="Images/earth_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnPublishedCountries" Click="btnPublishedCountries_Click" Label="{DynamicResource ribbon.button.data.publishedcountries.header}" LargeImageSource="/Images/earth_location_32.png" SmallImageSource="/Images/earth_location_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnCatalogs" Click="btnCatalogs_Click" Label="{DynamicResource ribbon.button.data.catalogs.header}" LargeImageSource="Images/book_blue_32.png" SmallImageSource="Images/book_blue_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnCategories" Click="btnCategories_Click" Label="{DynamicResource ribbon.button.data.categories.header}" LargeImageSource="Images/cubes_32.png" SmallImageSource="Images/cubes_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnPublishedCountryCategories" Click="btnPublishedCountryCategories_Click" Label="{DynamicResource ribbon.button.data.publishedcountrycategories.header}" LargeImageSource="/Images/book_red_32.png" SmallImageSource="/Images/book_red_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnCoins" Click="btnCoins_Click" Label="{DynamicResource ribbon.button.data.coins.header}" LargeImageSource="/Images/currency_euro_32.png" SmallImageSource="/Images/currency_euro_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnPubCountryCoins" Click="btnPubCountryCoins_Click" Label="{DynamicResource ribbon.button.data.pubcountrycoins.header}" LargeImageSource="/Images/currency_dollar_32.png" SmallImageSource="/Images/currency_dollar_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnColors" Click="btnColors_Click" Label="{DynamicResource ribbon.button.data.colors.header}" LargeImageSource="/Images/palette_32.png" SmallImageSource="/Images/palette_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnWatermarks" Click="btnWatermarks_Click" Label="{DynamicResource ribbon.button.data.watermarks.header}" LargeImageSource="/Images/step_32.png" SmallImageSource="/Images/step_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnTopocs" Click="btnTopocs_Click" Label="{DynamicResource ribbon.button.data.topics.header}" LargeImageSource="/Images/star_blue_32.png" SmallImageSource="/Images/star_blue_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnConditions" Click="btnConditions_Click" Label="{DynamicResource ribbon.button.data.conditions.header}" LargeImageSource="/Images/die_32.png" SmallImageSource="/Images/die_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnLocations" Click="btnLocations_Click" Label="{DynamicResource ribbon.button.data.location.header}" LargeImageSource="/Images/cabinet_32.png" SmallImageSource="/Images/cabinet_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnSuppliers" Click="btnSuppliers_Click" Label="{DynamicResource ribbon.button.data.suppliers.header}" LargeImageSource="/Images/briefcase2_32.png" SmallImageSource="/Images/briefcase2_16.png"></RibbonButton>
                    <RibbonButton x:Name="btnSupplierDeals" Click="btnSupplierDeals_Click" Label="{DynamicResource ribbon.button.data.supplierdeals.header}" LargeImageSource="/Images/briefcase2_document_32.png" SmallImageSource="/Images/briefcase2_document_16.png"></RibbonButton>
                </RibbonGroup>
                <RibbonGroup Header="{DynamicResource ribbon.group.languages.header}">
                    <RibbonToggleButton Label="English" IsChecked="True" x:Name="btnLanUK" Click="btnLanUK_Click" LargeImageSource="Images/Flags/flag_great_britain_32.png" SmallImageSource="Images/Flags/flag_great_britain_16.png"></RibbonToggleButton>
                    <RibbonToggleButton Label="Dansk" IsChecked="False" x:Name="btnLanDK" Click="btnLanDK_Click" LargeImageSource="Images/Flags/flag_denmark_32.png" SmallImageSource="Images/Flags/flag_denmark_16.png"></RibbonToggleButton>
                </RibbonGroup>
                <RibbonGroup Header="Dianotics">
                    <RibbonButton x:Name="btnDumbWorker" Click="btnDumbWorker_Click" Label="Dump Workinglist" LargeImageSource="/Images/scroll_32.png" SmallImageSource="/Images/scroll_16.png"></RibbonButton>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
        <Grid x:Name="grdStampView" Grid.Row="1" Visibility="Visible">
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="1"></ColumnDefinition>
                        <ColumnDefinition Width="1"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">

                            </Grid>
                            <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                            <TreeView x:Name="tvwContinents" Grid.Row="3">

                            </TreeView>
                        </Grid>
                        <GridSplitter Grid.Row="1"></GridSplitter>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">

                            </Grid>
                            <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                            <Grid Grid.Row="3">
                            </Grid>
                        </Grid>
                    </Grid>
                    <Label Grid.Column="1" Style="{StaticResource DarkLine}"></Label>
                    <Label Grid.Column="2" Style="{StaticResource LightLine}"></Label>
                </Grid>
                <GridSplitter Grid.Column="1"></GridSplitter>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="25"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Label Padding="0,8,8,0" Content="{StaticResource desktop.stamp.filter.continent}"></Label>
                            <ComboBox x:Name="cboFilterContinent" Height="20" Width="120"></ComboBox>
                            <Label Width="8"></Label>

                            <Label Padding="0,8,8,0" Content="{StaticResource desktop.stamp.filter.country}"></Label>
                            <ComboBox x:Name="cboFilterCountry" Height="20" Width="120"></ComboBox>
                            <Label Width="8"></Label>
                            
                            <Label Padding="0,8,8,0" Content="{StaticResource desktop.stamp.filter.publishedcountry}"></Label>
                            <ComboBox x:Name="cboFilterPublishedCountry" Height="20" Width="120"></ComboBox>
                            <Label Width="8"></Label>

                        </StackPanel>
                    </Grid>
                    <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                    <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="dgStamps" MouseDoubleClick="dgStamps_MouseDoubleClick" SelectionChanged="dgStamps_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Visibility="Collapsed"></DataGridTextColumn>
                                <DataGridTextColumn  Binding="{Binding PublishingCountry}" Width="80">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.publishingcountry}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="80" Binding="{Binding Catalog}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.catalog}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding FormattedIssued}" Width="80">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.issued}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Number}" Width="56">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.catalogno}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Facevalue}" Width="56">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.face}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Coin}" Width="32">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.coin}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Design}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.design}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Color}" Width="100">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.color}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" Binding="{Binding Category}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.category}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Width}" Width="48">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.width}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Height}" Width="48">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource dgstamps.header.height}"></TextBlock>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Label Grid.Row="4" Style="{StaticResource DarkLine}"></Label>
                    <Label Grid.Row="5" Style="{StaticResource LightLine}"></Label>
                    <Grid Grid.Row="6" Background="{DynamicResource SecondaryLight}">

                    </Grid>
                </Grid>
                <Grid Grid.Column="3" x:Name="grdStampDetails" Visibility="Collapsed" Width="180">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1"></ColumnDefinition>
                        <ColumnDefinition Width="1"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="1"></RowDefinition>
                        <RowDefinition Height="180"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                    <Label Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="4,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{StaticResource desktop.stampdetail.header.catalognumber}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailCatalogNumber"></Label>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Margin="4,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{StaticResource desktop.stampdetail.header.issued}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailIssued"></Label>
                            </Grid>
                        </Border>
                        <Border Grid.Row="4" Margin="4,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{StaticResource desktop.stampdetail.header.category}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailCategory"></Label>
                            </Grid>
                        </Border>
                        <Border Grid.Row="6" Margin="4,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{StaticResource desktop.stampdetail.header.topic}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailTopic"></Label>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="4"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="4,0,2,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Content="{StaticResource desktop.stampdetail.header.perforationh}" Style="{StaticResource LabelHeader}"></Label>
                                    <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailPerforationH"></Label>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Margin="2,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Content="{StaticResource desktop.stampdetail.header.perforationv}" Style="{StaticResource LabelHeader}"></Label>
                                    <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailPerforationV"></Label>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="10" Grid.RowSpan="3" Margin="4,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{StaticResource desktop.stampdetail.header.description}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailDescription"></Label>
                            </Grid>
                        </Border>
                        <Border Grid.Row="14" Margin="4,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Content="{StaticResource desktop.stampdetail.header.motive}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailMotive"></Label>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="4"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="4,0,2,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Content="{StaticResource desktop.stampdetail.header.class}" Style="{StaticResource LabelHeader}"></Label>
                                    <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailClass"></Label>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Margin="2,0,4,0" BorderThickness="1" BorderBrush="{StaticResource PrimaryLineDark}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Content="{StaticResource desktop.stampdetail.header.type}" Style="{StaticResource LabelHeader}"></Label>
                                    <Label Grid.Row="1" Padding="8,0" x:Name="lblDetailType"></Label>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DarkLine}"></Label>
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource LightLine}"></Label>
                    <Grid Grid.Row="3" Grid.Column="2">
                        <Image x:Name="selectedStampImage"></Image>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="grdStockView" Visibility="Collapsed">
            
        </Grid>
        <Label Grid.Row="2" Style="{StaticResource DarkLine}"></Label>
        <Label Grid.Row="3" Style="{StaticResource LightLine}"></Label>
        <Grid Grid.Row="4">
            
        </Grid>
    </Grid>
</Window>
