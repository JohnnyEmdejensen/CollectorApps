<Window x:Class="Collector.Client.Wpf.Dialogs.CountryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Collector.Client.Wpf.Dialogs"
        mc:Ignorable="d"
        Title="{DynamicResource countrydialog.title}" ResizeMode="NoResize" Tag="Countries" Height="400" Width="600" Background="{DynamicResource PrimaryBackground}" Icon="/Images/earth_48.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="1" Margin="8" Source="/Images/earth_48.png"></Image>
        </Grid>
        <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
        <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="4"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"></RowDefinition>
                    <RowDefinition Height="1"></RowDefinition>
                    <RowDefinition Height="1"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="4"></Label>
                        <Button x:Name="btnAdd" IsEnabled="False" Width="25" Click="btnAdd_Click">
                            <Image Source="/Images/add_16.png" Width="16" Height="16"></Image>
                        </Button>
                        <Label Width="4"></Label>
                        <Button x:Name="btnSave" IsEnabled="False" Width="25" Click="btnSave_Click">
                            <Image Source="/Images/disk_blue_16.png" Width="16" Height="16"></Image>
                        </Button>
                        <Label Width="4"></Label>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1"></ColumnDefinition>
                                <ColumnDefinition Width="1"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                        </Grid>
                        <Label Width="4"></Label>
                        <Button x:Name="btnDelete" IsEnabled="False" Width="25" Click="btnDelete_Click">
                            <Image Source="/Images/delete2_16.png"  Width="16" Height="16"></Image>
                        </Button>
                        <Label Width="4"></Label>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1"></ColumnDefinition>
                                <ColumnDefinition Width="1"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                        </Grid>
                        <Label Width="4"></Label>
                        <Button x:Name="btnLoadImage" IsEnabled="False" Width="25" Click="btnLoadImage_Click">
                            <Image Source="/Images/folder_16.png"  Width="16" Height="16"></Image>
                        </Button>
                        <Button x:Name="btnPasteImage" IsEnabled="False" Width="25" Click="btnPasteImage_Click">
                            <Image Source="/Images/paste_16.png"  Width="16" Height="16"></Image>
                        </Button>

                    </StackPanel>
                </Grid>
                <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="4"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Column="1" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource countrydialog.header.name}" Style="{StaticResource LabelHeader}"></Label>
                            <TextBox x:Name="txtName" Grid.Row="1" Text="{Binding Path=Name, Mode=TwoWay}"></TextBox>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="ISO" Style="{StaticResource LabelHeader}"></Label>
                            <TextBox Grid.Row="1" Text="{Binding Path=Iso, Mode=TwoWay}" Width="64" HorizontalAlignment="Left"></TextBox>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="NUMBER" Style="{StaticResource LabelHeader}"></Label>
                            <TextBox Grid.Row="1" Text="{Binding Path=Number, Mode=TwoWay}" Width="64" HorizontalAlignment="Left"></TextBox>
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="CONTINENT" Style="{StaticResource LabelHeader}"></Label>
                            <ComboBox Grid.Row="1" x:Name="cboContinent" SelectedValue="{Binding Path=ContinentId, Mode=TwoWay}"></ComboBox>
                        </Grid>
                        <Grid Grid.Row="8" Grid.RowSpan="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="IMAGE" Style="{StaticResource LabelHeader}"></Label>
                            <Image Grid.Row="1" x:Name="imgFlag">
                                
                            </Image>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1"></GridSplitter>
            <Grid Grid.Column="2">
                <TabControl>
                    <TabItem Header="{DynamicResource countrydialog.title}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Filter:" Padding="0,0,8,0" VerticalAlignment="Center"></Label>
                                    <TextBox x:Name="txtFilter" TextChanged="txtFilter_TextChanged" Width="100" Height="20" VerticalAlignment="Center"></TextBox>
                                </StackPanel>
                            </Grid>
                            <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                            <Grid Grid.Row="3">
                                <DataGrid x:Name="dgCountries" SelectionChanged="dgCountries_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Visibility="Collapsed"></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Name}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource countrydialog.columnheader.name}"></TextBlock>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="24" Binding="{Binding Iso}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource countrydialog.columnheader.iso}"></TextBlock>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="32" Binding="{Binding Number}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource countrydialog.columnheader.number}"></TextBlock>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="100" Binding="{Binding Continent}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource countrydialog.columnheader.continent}"></TextBlock>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Label Grid.Row="4" Style="{StaticResource DarkLine}"></Label>
        <Label Grid.Row="5" Style="{StaticResource LightLine}"></Label>
        <Grid Grid.Row="6" >
            
        </Grid>
    </Grid>
</Window>
