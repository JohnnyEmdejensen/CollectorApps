<Window x:Class="Collector.Client.Wpf.Dialogs.StampDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Collector.Client.Wpf.Dialogs"
        mc:Ignorable="d"
        Title="{DynamicResource stampdialog.title}" Tag="Stamp" Height="600" Width="800" Background="{DynamicResource PrimaryBackground}" Icon="/Images/photo_portrait_48.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgDialog" Grid.Column="1" Margin="8" Source="/Images/photo_portrait_48.png"></Image>
        </Grid>
        <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
        <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="4"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"></RowDefinition>
                    <RowDefinition Height="1"></RowDefinition>
                    <RowDefinition Height="1"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="4"></Label>
                        <Button x:Name="btnAdd" IsEnabled="False" Width="25" Click="btnAdd_Click">
                            <Image Source="/Images/add_16.png" Width="16" Height="16"></Image>
                        </Button>
                        <Label Width="4"></Label>
                        <Button x:Name="btnSave" IsEnabled="False" Width="25" Click="btnSave_Click">
                            <Image Source="/Images/disk_blue_16.png" Width="16" Height="16"></Image>
                        </Button>
                        <Label Width="4"></Label>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1"></ColumnDefinition>
                                <ColumnDefinition Width="1"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                        </Grid>
                        <Label Width="4"></Label>
                        <Button x:Name="btnDelete" IsEnabled="False" Width="25" Click="btnDelete_Click">
                            <Image Source="/Images/delete2_16.png"  Width="16" Height="16"></Image>
                        </Button>
                    </StackPanel>
                </Grid>
                <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="4"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Column="1" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition Height="32"></RowDefinition>
                            <RowDefinition Height="4"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="lblPublishedCountry" MouseDown="lblPublishedCountry_MouseDown" Cursor="Hand" Content="{DynamicResource stampdialog.header.publishedcountry}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                                <Label x:Name="lblCatalog" MouseDown="lblCatalog_MouseDown" Cursor="Hand" Grid.Column="2" Content="{DynamicResource stampdialog.header.catalog}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboPublishedCountry" Grid.Column="0" SelectedValue="{Binding Path=PublishedCountryId, Mode=TwoWay}"></ComboBox>
                                <ComboBox x:Name="cboCatalog" Grid.Column="2" SelectedValue="{Binding Path=CatalogId, Mode=TwoWay}"></ComboBox>

                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource stampdialog.header.formattetissued}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Column="2" Content="{DynamicResource stampdialog.header.catalognumber}" Style="{StaticResource LabelHeader}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Path=Issued, Mode=TwoWay}"></TextBox>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="8"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="8"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Prefix}" Grid.Column="0"></TextBox>
                                    <TextBox x:Name="txtNumber" Text="{Binding Number}" Grid.Column="2"></TextBox>
                                    <TextBox Text="{Binding Suffix}" Grid.Column="4"></TextBox>
                                </Grid>
                            </Grid>
                        </Grid>
                                                
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="lblCategory" MouseDown="lblCategory_MouseDown" Cursor="Hand" Content="{DynamicResource stampdialog.header.category}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                                <Label x:Name="lblWatermark" MouseDown="lblWatermark_MouseDown" Cursor="Hand" Grid.Column="2" Content="{DynamicResource stampdialog.header.watermark}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboCategory" Grid.Row="1" SelectedValue="{Binding Path=CategoryId, Mode=TwoWay}"></ComboBox>
                                <ComboBox Grid.Column="2" x:Name="cboWatermark" Grid.Row="1" SelectedValue="{Binding Path=WatermarkId, Mode=TwoWay}"></ComboBox>
                            </Grid>
                        </Grid>
                        
                        <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"></ColumnDefinition>
                                <ColumnDefinition Width="8"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource stampdialog.header.facevalue}" Style="{StaticResource LabelHeader}"></Label>
                            <Label x:Name="lblCoinUnit" MouseDown="lblCoinUnit_MouseDown" Cursor="Hand" Grid.Row="0" Grid.Column="2" Content="{DynamicResource stampdialog.header.coin}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Path=Facevalue, Mode=TwoWay}"></TextBox>
                                <ComboBox x:Name="cboCoin" SelectedValue="{Binding Path=CoinId, Mode=TwoWay}" Grid.Column="2"></ComboBox>
                            </Grid>
                        </Grid>
                        
                        <Grid Grid.Row="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource stampdialog.header.design}" Style="{StaticResource LabelHeader}"></Label>
                            <TextBox Grid.Row="1" Text="{Binding Path=Design, Mode=TwoWay}"></TextBox>
                        </Grid>
                        
                        <Grid Grid.Row="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="lblColor" MouseDown="lblColor_MouseDown" Cursor="Hand" Content="{DynamicResource stampdialog.header.color}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                                <Label x:Name="lblTopic" MouseDown="lblTopic_MouseDown" Cursor="Hand" Grid.Column="2" Content="{DynamicResource stampdialog.header.topic}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboColor" Grid.Column="0" SelectedValue="{Binding Path=ColorId, Mode=TwoWay}"></ComboBox>
                                <ComboBox Grid.Column="2" x:Name="cboTopic" Grid.Row="1" SelectedValue="{Binding Path=TopicId, Mode=TwoWay}"></ComboBox>
                            </Grid>
                        </Grid>
                        
                        <Grid Grid.Row="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label x:Name="lblPerforations" MouseDown="lblPerforations_MouseDown" Content="{DynamicResource stampdialog.header.perforations}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboPerforationH" SelectedValue="{Binding Path=PerforationHorId, Mode=TwoWay}" Grid.Column="0"></ComboBox>
                                <ComboBox x:Name="cboPerforationV" SelectedValue="{Binding Path=PerforationVerId, Mode=TwoWay}" Grid.Column="2"></ComboBox>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource stampdialog.header.motive}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Column="2" Content="{DynamicResource stampdialog.header.heightwidth}" Style="{StaticResource LabelHeader}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Path=Motive, Mode=TwoWay}"></TextBox>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="8"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Path=Height, Mode=TwoWay}"></TextBox>
                                    <TextBox Text="{Binding Path=Width, Mode=TwoWay}" Grid.Column="2"></TextBox>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource stampdialog.header.designer}" Style="{StaticResource LabelHeader}"></Label>
                                <Label Grid.Column="2" Content="{DynamicResource stampdialog.header.ingraver}" Style="{StaticResource LabelHeader}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Path=Designer, Mode=TwoWay}"></TextBox>
                                <TextBox Text="{Binding Path=Ingraver, Mode=TwoWay}" Grid.Column="2"></TextBox>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="18" Grid.RowSpan="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Label Content="{DynamicResource stampdialog.header.description}" Style="{StaticResource LabelHeader}"></Label>
                            <TextBox Grid.Row="1" VerticalContentAlignment="Top" Text="{Binding Path=Description, Mode=TwoWay}"></TextBox>
                        </Grid>

                        <Grid Grid.Row="22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="lblClass" MouseDown="lblClass_MouseDown" Cursor="Hand" Content="{DynamicResource stampdialog.header.class}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                                <Label x:Name="lblType" MouseDown="lblType_MouseDown" Cursor="Hand" Grid.Column="2" Content="{DynamicResource stampdialog.header.type}" Style="{StaticResource LabelHeaderClickAble}"></Label>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cboClasses" Grid.Row="1" SelectedValue="{Binding Path=ClassId, Mode=TwoWay}"></ComboBox>
                                <ComboBox Grid.Column="2" x:Name="cboTypes" Grid.Row="1" SelectedValue="{Binding Path=TypeId, Mode=TwoWay}"></ComboBox>
                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1"></GridSplitter>
            <Grid Grid.Column="2">
                <TabControl>
                    <TabItem x:Name="tabItemStock" Header="{DynamicResource stampdialog.tab.stock.header}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Label Width="4"></Label>
                                    <Button x:Name="btnAddStock" IsEnabled="False" Width="25" Click="btnAddStock_Click">
                                        <Image Source="/Images/add_16.png" Width="16" Height="16"></Image>
                                    </Button>
                                    <Label Width="4"></Label>
                                    <Button x:Name="btnSaveStock" IsEnabled="False" Width="25" Click="btnSaveStock_Click">
                                        <Image Source="/Images/disk_blue_16.png" Width="16" Height="16"></Image>
                                    </Button>
                                    <Label Width="4"></Label>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1"></ColumnDefinition>
                                            <ColumnDefinition Width="1"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                                        <Label Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                                    </Grid>
                                    <Label Width="4"></Label>
                                </StackPanel>
                            </Grid>
                            <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                            <Grid Grid.Row="3" x:Name="grdStockContainer" VerticalAlignment="Top">
                                <StackPanel x:Name="spContainer" Orientation="Vertical">
                                    
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabItemImages" Header="{DynamicResource stampdialog.tab.images.header}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Label Width="4"></Label>
                                    <Button x:Name="btnAddImage" IsEnabled="False" Width="25" ToolTip="Add picture from clipboard" Click="btnAddImage_Click">
                                        <Image Source="/Images/add_16.png" Width="16" Height="16"></Image>
                                    </Button>
                                    <Label Width="4"></Label>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1"></ColumnDefinition>
                                            <ColumnDefinition Width="1"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                                        <Label Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                                    </Grid>
                                    <Label Width="4"></Label>
                                    <Button x:Name="btnOpenImage" IsEnabled="False" Width="25" Click="btnOpenImage_Click">
                                        <Image Source="/Images/folder_16.png"  Width="16" Height="16"></Image>
                                    </Button>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1"></ColumnDefinition>
                                            <ColumnDefinition Width="1"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Style="{StaticResource DarkLine}"></Label>
                                        <Label Grid.Column="1" Style="{StaticResource LightLine}"></Label>
                                    </Grid>
                                    <Label Width="4"></Label>
                                    <Label Width="4"></Label>
                                    <Button x:Name="btnDeleteImage" IsEnabled="False" Width="25" Click="btnDeleteImage_Click">
                                        <Image Source="/Images/delete2_16.png"  Width="16" Height="16"></Image>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition Height="4"></RowDefinition>
                                    <RowDefinition Height="120"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition Height="1"></RowDefinition>
                                        <RowDefinition Height="1"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Image x:Name="imgBig" HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
                                    </Grid>
                                    <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                                    <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                                </Grid>
                                <GridSplitter Grid.Row="1"></GridSplitter>
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal" x:Name="spImagePreviewContainer">
                                        
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabItemPrices" Header="{DynamicResource stampdialog.tab.prices.header}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition Height="1"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Label Width="4"></Label>
                                <Button x:Name="btnSavePrices" Width="25" Click="btnSavePrices_Click">
                                    <Image Source="/Images/disk_blue_16.png" Width="16" Height="16"></Image>
                                </Button>
                            </StackPanel>
                            <Label Grid.Row="1" Style="{StaticResource DarkLine}"></Label>
                            <Label Grid.Row="2" Style="{StaticResource LightLine}"></Label>
                            <StackPanel Grid.Row="3" x:Name="grdPricesContainer" Orientation="Vertical">
                                
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Label Grid.Row="4" Style="{StaticResource DarkLine}"></Label>
        <Label Grid.Row="5" Style="{StaticResource LightLine}"></Label>
        <Grid Grid.Row="6" >

        </Grid>
    </Grid>
</Window>
